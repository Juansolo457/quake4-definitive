+/*
+================
+idPlayer::UpdateHaloAimAssist
+
+openQ4: Halo CE's aim assist (OpenCE aim_assist.c aim_assist and local_player_aim_assist) for
+pm_AimAssist 3. The weapon gives an autoaim cone (shots bend) and a wider magnetism cone (the
+view sticks), both with Halo's falloff and both tightened by zoom. Living hostile actors with
+their body point inside either cone are ranked by autoaim level, magnetism level, distance and
+angle, and the first in clear sight becomes bestEnemy, with its motion across the view for the
+stick's adhesion.
+================
+*/
+void idPlayer::UpdateHaloAimAssist( void ) {
+	aimAssistAutoaimLevel = 0.0f;
+	aimAssistMagnetismLevel = 0.0f;
+	aimAssistAngularVelocity.Zero();
+	bestEnemy = NULL;
+
+	haloAimAssist_t parameters;
+	if ( weapon == NULL || !weapon->GetHaloAimAssist( parameters ) ) {
+		return;
+	}
+
+	// zoomed, the angles shrink and the reach grows by the magnification, as in Halo
+	const float baseFov = CalcFov( false );
+	const float zoomFov = CalcFov( true );
+	const float magnification = ( zoomFov > 0.0f && zoomFov < baseFov ) ?
+		idMath::Tan( DEG2RAD( baseFov * 0.5f ) ) / idMath::Tan( DEG2RAD( zoomFov * 0.5f ) ) : 1.0f;
+	const float angleScale = pm_AimAssistHaloScale.GetFloat() / magnification;
+	const float autoaimAngle = parameters.autoaimAngle * angleScale;
+	const float magnetismAngle = parameters.magnetismAngle * angleScale;
+	const float autoaimDistance = parameters.autoaimDistance * magnification;
+	const float magnetismDistance = parameters.magnetismDistance * magnification;
+	aimAssistDeviation = Max( parameters.deviationAngle, parameters.autoaimAngle ) * angleScale;
+	const float searchAngle = Min( Max( autoaimAngle, magnetismAngle ), 60.0f );
+	const float searchDistance = Max( autoaimDistance, magnetismDistance );
+	if ( searchAngle <= 0.0f || searchDistance <= 0.0f ) {
+		return;
+	}
+
+	const idVec3 eye = GetEyePosition();
+	const idMat3 axis = viewAngles.ToMat3();
+	const idVec3 &dir = axis[0];
+	const float farRadius = searchDistance * idMath::Tan( DEG2RAD( searchAngle ) );
+	idBounds bounds( eye );
+	for ( int i = 0; i < 4; i++ ) {
+		bounds.AddPoint( eye + dir * searchDistance + axis[1] * ( ( i & 1 ) ? farRadius : -farRadius ) +
+			axis[2] * ( ( i & 2 ) ? farRadius : -farRadius ) );
+	}
+
+	struct candidate_t {
+		idActor *	actor;
+		idVec3		point;
+		float		distance;
+		float		angle;
+		float		autoaim;
+		float		magnetism;
+	};
+	static const int MAX_CANDIDATES = 64;
+	candidate_t candidates[ MAX_CANDIDATES ];
+	int candidateCount = 0;
+	idClipModel *clipModels[ MAX_GENTITIES ];
+	const int clipCount = gameLocal.ClipModelsTouchingBounds( this, bounds, CONTENTS_BODY, clipModels, MAX_GENTITIES );
+	for ( int i = 0; i < clipCount && candidateCount < MAX_CANDIDATES; i++ ) {
+		idEntity *ent = clipModels[ i ]->GetEntity();
+		if ( ent == NULL || ent->IsHidden() || ent->health <= 0 || !ent->IsType( idAI::GetClassType() ) ||
+			static_cast<idAI *>( ent )->team == team ) {
+			continue;
+		}
+		bool listed = false;
+		for ( int j = 0; j < candidateCount && !listed; j++ ) {
+			listed = ( candidates[ j ].actor == ent );
+		}
+		if ( listed ) {
+			continue;
+		}
+		candidate_t c;
+		c.actor = static_cast<idActor *>( ent );
+		c.point = HaloAimAssist_BodyPoint( ent->GetPhysics()->GetAbsBounds(), eye, dir );
+		idVec3 toPoint = c.point - eye;
+		c.distance = toPoint.Normalize();
+		if ( c.distance <= 0.0f ) {
+			continue;
+		}
+		c.angle = RAD2DEG( idMath::ACos( idMath::ClampFloat( -1.0f, 1.0f, toPoint * dir ) ) );
+		c.autoaim = HaloAimAssist_Attenuation( c.distance, autoaimDistance ) * HaloAimAssist_Attenuation( c.angle, autoaimAngle );
+		c.magnetism = HaloAimAssist_Attenuation( c.distance, magnetismDistance ) * HaloAimAssist_Attenuation( c.angle, magnetismAngle );
+		if ( c.autoaim <= 0.0f && c.magnetism <= 0.0f ) {
+			continue;
+		}
+		// Halo's order: autoaim level, magnetism level, distance, angle
+		int at = candidateCount++;
+		while ( at > 0 ) {
+			const candidate_t &prev = candidates[ at - 1 ];
+			const bool before = c.autoaim != prev.autoaim ? c.autoaim > prev.autoaim :
+				c.magnetism != prev.magnetism ? c.magnetism > prev.magnetism :
+				c.distance != prev.distance ? c.distance < prev.distance : c.angle < prev.angle;
+			if ( !before ) {
+				break;
+			}
+			candidates[ at ] = prev;
+			at--;
+		}
+		candidates[ at ] = c;
+	}
+
+	for ( int i = 0; i < candidateCount; i++ ) {
+		const candidate_t &c = candidates[ i ];
+		trace_t tr;
+		gameLocal.TracePoint( this, tr, eye, c.point, MASK_SHOT_BOUNDINGBOX, this );
+		idEntity *hit = tr.fraction < 1.0f ? gameLocal.entities[ tr.c.entityNum ] : NULL;
+		if ( hit != NULL && hit != c.actor && hit->GetBindMaster() != c.actor ) {
+			continue;
+		}
+		bestEnemy = c.actor;
+		aimAssistPoint = c.point;
+		aimAssistAutoaimLevel = c.autoaim;
+		aimAssistMagnetismLevel = c.magnetism;
+
+		// the target's motion across the view (Halo's relative angular velocity), in degrees per second
+		const idVec3 r = c.point - eye;
+		const idVec3 v = c.actor->GetPhysics()->GetLinearVelocity() - GetPhysics()->GetLinearVelocity();
+		const float horizontalSqr = r.x * r.x + r.y * r.y;
+		if ( horizontalSqr > 1.0f ) {
+			const float horizontal = idMath::Sqrt( horizontalSqr );
+			const float yawRate = ( r.x * v.y - r.y * v.x ) / horizontalSqr;
+			const float pitchUpRate = ( horizontal * v.z - r.z / horizontal * ( r.x * v.x + r.y * v.y ) ) / ( r.z * r.z + horizontalSqr );
+			// Halo caps it at 6 degrees yaw and 3 pitch per 30 Hz tick; Quake 4 pitch is positive looking down
+			aimAssistAngularVelocity.yaw = idMath::ClampFloat( -180.0f, 180.0f, RAD2DEG( yawRate ) );
+			aimAssistAngularVelocity.pitch = idMath::ClampFloat( -90.0f, 90.0f, -RAD2DEG( pitchUpRate ) );
+		}
+		if ( pm_showAimAssist.GetBool() ) {
+			gameRenderWorld->DebugBounds( c.autoaim > 0.0f ? colorRed : colorYellow, idBounds( c.point ).Expand( 2.0f ), vec3_origin, 20 );
+		}
+		break;
+	}
+}
