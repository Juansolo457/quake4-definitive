diff --git a/src/framework/UsercmdGen.cpp b/src/framework/UsercmdGen.cpp
index a5d227d..4234a8a 100644
--- a/src/framework/UsercmdGen.cpp
+++ b/src/framework/UsercmdGen.cpp
@@ -1225,6 +1225,13 @@ void idUsercmdGenLocal::JoystickMove( void ) {
 		}
 	}
 
+	// openQ4: Halo-style adhesion (pm_AimAssist 3). While either stick is in use, the view also
+	// follows the target's motion across it, which the game sends in degrees per second.
+	if ( aimWithController && !weaponWheel && ( lookAxisX != 0.0f || lookAxisY != 0.0f || moveAxisX != 0 || moveAxisY != 0 ) ) {
+		viewangles[YAW] += cvarSystem->GetCVarFloat( "pm_joystickAdhesionYaw" ) * usercmdSeconds;
+		viewangles[PITCH] += cvarSystem->GetCVarFloat( "pm_joystickAdhesionPitch" ) * usercmdSeconds;
+	}
+
 	if ( hasDedicatedLookAxis ) {
 		cmd.rightmove = idMath::ClampChar( cmd.rightmove + moveAxisX );
 		cmd.forwardmove = idMath::ClampChar( cmd.forwardmove + moveAxisY );
@@ -1509,8 +1516,10 @@ void idUsercmdGenLocal::InitForNewMap( void ) {
 	toggled_zoom.Clear();
 	toggled_run.on = in_alwaysRun.GetBool();
 
-	// a friction value left over from the previous map must not slow the controller
+	// a friction or adhesion value left over from the previous map must not steer the controller
 	cvarSystem->SetCVarInteger( "pm_joystickSlow", 0 );
+	cvarSystem->SetCVarFloat( "pm_joystickAdhesionYaw", 0.0f );
+	cvarSystem->SetCVarFloat( "pm_joystickAdhesionPitch", 0.0f );
 
 	Clear();
 	ClearAngles();
diff --git a/src/game/Player.cpp b/src/game/Player.cpp
index fd4dd53..9cd82ea 100644
--- a/src/game/Player.cpp
+++ b/src/game/Player.cpp
@@ -1252,6 +1252,12 @@ idPlayer::idPlayer() {
 
 	alreadyDidTeamAnnouncerSound = false;
 
+	aimAssistAutoaimLevel	= 0.0f;
