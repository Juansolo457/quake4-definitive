+/*
+================
+HaloAimAssist_Attenuation
+
+openQ4: Halo CE's falloff (aim_assist.c compute_attenuation): full strength up to half the
+limit, then linear to nothing at the limit.
+================
+*/
+static float HaloAimAssist_Attenuation( float value, float maximum ) {
+	if ( value >= maximum ) {
+		return 0.0f;
+	}
+	if ( value <= maximum * 0.5f ) {
+		return 1.0f;
+	}
+	return ( maximum - value ) / ( maximum * 0.5f );
+}
+
+/*
+================
+HaloAimAssist_BodyPoint
+
+openQ4: Halo CE's autoaim pill (object_compute_autoaim_target): the point of a capsule along the
+body closest to the aiming line, pulled toward the line by at most the capsule's radius. A
+vertical capsule inside the actor's bounds stands in for Halo's per-biped pill.
+================
+*/
+static idVec3 HaloAimAssist_BodyPoint( const idBounds &bounds, const idVec3 &eye, const idVec3 &dir ) {
+	const idVec3 size = bounds.Size();
+	const float width = 0.35f * Min( size.x, size.y );
+	const idVec3 center = bounds.GetCenter();
+	const idVec3 base( center.x, center.y, bounds[0].z + width );
+	const idVec3 height( 0.0f, 0.0f, Max( 0.0f, size.z - 2.0f * width ) );
+
+	idVec3 point = base;
+	const idVec3 normal = height.Cross( dir );
+	const float normalLengthSqr = normal.LengthSqr();
+	if ( normalLengthSqr > 0.0f ) {
+		const float t = ( ( eye - base ).Cross( dir ) * normal ) / normalLengthSqr;
+		point = base + height * idMath::ClampFloat( 0.0f, 1.0f, t );
+	}
+
+	const idVec3 offset = point - eye;
+	idVec3 perpendicular = offset - dir * ( offset * dir );
+	const float length = perpendicular.Length();
+	if ( length > width && length > 0.0f ) {
+		perpendicular *= width / length;
+	}
+	return point - perpendicular;
+}
