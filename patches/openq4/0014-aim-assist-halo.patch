+/*
+=====================
+rvWeapon::GetHaloAimAssist
+
+openQ4: Halo CE's aim assist values for the Quake 4 weapon that plays the same part, read from the
+Xbox maps' weapon tags. Halo distances are in its world units, about ten feet, so 120 Quake 4
+units each. Only the tuned weapons have a profile; the rest keep the 360 assist.
+=====================
+*/
+bool rvWeapon::GetHaloAimAssist( haloAimAssist_t &parameters ) const {
+	static const struct {
+		const char *	weaponDef;
+		haloAimAssist_t	halo;				// degrees, Halo world units
+	} profiles[] = {
+		{ "weapon_blaster",		{ 3.0f, 30.0f,  6.0f, 30.0f, 0.0f } },		// pistol
+		{ "weapon_machinegun",	{ 6.0f, 25.0f, 12.0f, 25.0f, 0.0f } },		// assault rifle
+		{ "weapon_shotgun",		{ 6.0f, 15.0f, 12.0f, 15.0f, 0.0f } },		// shotgun
+	};
+	static const int NUM_PROFILES = sizeof( profiles ) / sizeof( profiles[0] );
+	static const float HALO_WORLD_UNIT = 120.0f;
+
+	if ( weaponDef == NULL ) {
+		return false;
+	}
+	for ( int i = 0; i < NUM_PROFILES; i++ ) {
+		if ( idStr::Icmp( weaponDef->GetName(), profiles[ i ].weaponDef ) == 0 ) {
+			parameters = profiles[ i ].halo;
+			parameters.autoaimDistance *= HALO_WORLD_UNIT;
+			parameters.magnetismDistance *= HALO_WORLD_UNIT;
+			return true;
+		}
+	}
+	return false;
+}
