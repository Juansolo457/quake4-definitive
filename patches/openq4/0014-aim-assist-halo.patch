+/*
+=====================
+rvWeapon::HaloMuzzleAim
+
+openQ4: Halo CE's shot bend (OpenCE player_control.c, aim assist on the weapon's aim vector) for
+pm_AimAssist 3. The shot turns from the crosshair toward the point on the target's body nearest
+the crosshair (idPlayer::aimAssistPoint) by the autoaim level, so a target near the edge of the
+cone pulls less, and never by more than the deviation angle. A target that is only inside the
+magnetism cone leaves the shot alone; so does a crosshair already on the target or on an ally.
+=====================
+*/
+void rvWeapon::HaloMuzzleAim( const idVec3 &muzzleOrigin, idMat3 &muzzleAxis ) {
+	idActor *enemy = owner->bestEnemy.GetEntity();
+	const float level = owner->aimAssistAutoaimLevel;
+	if ( enemy == NULL || level <= 0.0f ) {
+		if ( pm_showAimAssist.GetBool() ) {
+			gameLocal.Printf( "aim assist muzzle aim (Halo): shot not bent, %s\n", enemy != NULL ? "view magnetism only" : "no enemy in the aim cone" );
+		}
+		return;
+	}
+
+	const idVec3 eye = owner->GetEyePosition();
+	trace_t tr;
+	gameLocal.TracePoint( owner, tr, eye, eye + owner->viewAngles.ToForward() * 15360.0f, MASK_SHOT_RENDERMODEL, owner );
+	idEntity *hit = tr.fraction < 1.0f ? gameLocal.entities[ tr.c.entityNum ] : NULL;
+	if ( hit != NULL && hit->GetBindMaster() != NULL ) {
+		hit = hit->GetBindMaster();
+	}
+	if ( hit == enemy || ( hit != NULL && hit->IsType( idActor::GetClassType() ) && static_cast<idActor *>( hit )->team == owner->team ) ) {
+		if ( pm_showAimAssist.GetBool() ) {
+			gameLocal.Printf( "aim assist muzzle aim (Halo): crosshair on %s %s\n", hit == enemy ? "target" : "ally", hit->GetName() );
+		}
+		return;
+	}
+
+	const idVec3 aim = muzzleAxis[ 0 ];
+	idVec3 toTarget = owner->aimAssistPoint - muzzleOrigin;
+	if ( toTarget.Normalize() <= 0.0f ) {
+		return;
+	}
+	// Halo's fast_normals_interpolate, then pin_normal_to_cone3d around the unbent aim
+	idVec3 dir = aim + ( toTarget - aim ) * level;
+	if ( dir.Normalize() <= 0.0f ) {
+		return;
+	}
+	const float maxAngle = DEG2RAD( owner->aimAssistDeviation );
+	const float cosine = idMath::ClampFloat( -1.0f, 1.0f, dir * aim );
+	if ( idMath::ACos( cosine ) > maxAngle ) {
+		idVec3 side = dir - aim * cosine;
+		if ( side.Normalize() > 0.0f ) {
+			dir = aim * idMath::Cos( maxAngle ) + side * idMath::Sin( maxAngle );
+		}
+	}
+	if ( pm_showAimAssist.GetBool() ) {
+		gameLocal.Printf( "aim assist muzzle aim (Halo): %s, autoaim level %.2f, bent %.2f of %.2f degrees (cap %.2f)\n", enemy->GetName(), level,
+			RAD2DEG( idMath::ACos( idMath::ClampFloat( -1.0f, 1.0f, dir * aim ) ) ),
+			RAD2DEG( idMath::ACos( idMath::ClampFloat( -1.0f, 1.0f, toTarget * aim ) ) ), owner->aimAssistDeviation );
+		gameRenderWorld->DebugArrow( colorYellow, muzzleOrigin, muzzleOrigin + dir * ( owner->aimAssistPoint - muzzleOrigin ).Length(), 2, 1000 );
+	}
+	muzzleAxis = dir.ToMat3();
+}
