+/*
+=====================
+rvWeapon::XenonMuzzleAim
+
+openQ4: the Xbox 360 build's muzzle aim, pm_AimAssist 2 (default.xex rvWeapon::Attack, 0x8250D670).
+While the aim assist has a target (idPlayer::bestEnemy) and the view ray does not already hit it,
+the shot leaves the muzzle toward the target's joint nearest that ray, or toward its origin raised
+32 units when no joint lies ahead. A teammate under the crosshair is never shot past: the shot goes
+to the crosshair point instead. The 360 did this for every input and in multiplayer; here it is
+single player and controller only. pm_AimAssistBump and pm_AimAssistThreshold are unused there too.
+=====================
+*/
+void rvWeapon::XenonMuzzleAim( const idVec3 &muzzleOrigin, idMat3 &muzzleAxis ) {
+	// ui_radialStickActive is the engine's last-input-was-a-controller flag, refreshed every usercmd.
+	const bool controller = cvarSystem->GetCVarBool( "ui_radialStickActive" ) || pm_AimAssistAnyInput.GetBool();
+	if ( pm_AimAssist.GetInteger() != 2 || gameLocal.isMultiplayer || owner == NULL || !controller || !AllowAutoAim() ) {
+		return;
+	}
+	idActor *enemy = owner->bestEnemy.GetEntity();
+	if ( enemy == NULL ) {
+		return;
+	}
+
+	const idVec3 eye = owner->GetEyePosition();
+	const idVec3 end = eye + owner->viewAngles.ToForward() * pm_AimAssistDistance.GetInteger();
+	trace_t tr;
+	gameLocal.TracePoint( owner, tr, eye, end, MASK_SHOT_RENDERMODEL, owner );
+	idEntity *hit = tr.fraction < 1.0f ? gameLocal.entities[ tr.c.entityNum ] : NULL;
+	if ( hit != NULL && hit->GetBindMaster() != NULL ) {
+		hit = hit->GetBindMaster();
+	}
+	if ( hit == enemy ) {
+		if ( pm_showAimAssist.GetBool() ) {
+			gameLocal.Printf( "aim assist muzzle aim: crosshair on %s\n", enemy->GetName() );
+		}
+		return;
+	}
+
+	idVec3 target = end;
+	bool ally = false;
+	for ( idActor *actor = aiManager.GetAllyTeam( (aiTeam_t)owner->team ); actor != NULL && !ally; actor = actor->teamNode.Next() ) {
+		ally = ( actor == hit );
+	}
+	if ( !ally ) {
+		// The joint with the smallest angle from the view ray, in the target's model space.
+		const renderEntity_t *renderEntity = enemy->GetRenderEntity();
+		const idMat3 toLocal = renderEntity->axis.Transpose();
+		const idVec3 localEye = ( eye - renderEntity->origin ) * toLocal;
+		idVec3 localRay = ( end - renderEntity->origin ) * toLocal - localEye;
+		localRay.Normalize();
+		idAnimator *animator = enemy->GetAnimator();
+		jointHandle_t best = INVALID_JOINT;
+		float bestDot = 0.0f;
+		for ( int i = 0; animator != NULL && i < animator->NumJoints(); i++ ) {
+			idVec3 jointOrigin;
+			idMat3 jointAxis;
+			animator->GetJointTransform( (jointHandle_t)i, gameLocal.time, jointOrigin, jointAxis );
+			idVec3 toJoint = jointOrigin - localEye;
+			toJoint.Normalize();
+			const float dot = toJoint * localRay;
+			if ( dot > bestDot ) {
+				bestDot = dot;
+				best = (jointHandle_t)i;
+			}
+		}
+		idMat3 jointAxis;
+		if ( best <= 0 || !enemy->GetJointWorldTransform( best, gameLocal.time, target, jointAxis ) ) {
+			target = renderEntity->origin + idVec3( 0.0f, 0.0f, 32.0f );
+		}
+		if ( pm_showAimAssist.GetBool() ) {
+			const char *jointName = ( best > 0 && animator != NULL ) ? animator->GetJointName( best ) : "origin+32";
+			gameLocal.Printf( "aim assist muzzle aim: %s joint %s (crosshair on %s)\n", enemy->GetName(), jointName ? jointName : "?",
+				hit != NULL ? hit->GetName() : ( tr.fraction < 1.0f ? "world" : "nothing" ) );
+		}
+	} else if ( pm_showAimAssist.GetBool() ) {
+		gameLocal.Printf( "aim assist muzzle aim: ally %s under the crosshair\n", hit->GetName() );
+	}
+	if ( pm_showAimAssist.GetBool() ) {
+		gameRenderWorld->DebugArrow( colorYellow, muzzleOrigin, target, 2, 1000 );
+	}
+
+	idVec3 dir = target - muzzleOrigin;
+	if ( dir.Normalize() > 0.0f ) {
+		muzzleAxis = dir.ToMat3();
+	}
 }
 
