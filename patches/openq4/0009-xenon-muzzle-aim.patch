+/*
+==================
+Cmd_TestMuzzleAim_f
+
+openQ4: runs the aim assist muzzle aim (pm_AimAssist 2) from the view, without firing, and
+prints how far it would turn the shot. pm_showAimAssist 1 also names the target and draws it.
+"testMuzzleAim aim" then turns the view to where the shot would go.
+==================
+*/
+static void Cmd_TestMuzzleAim_f( const idCmdArgs &args ) {
+	idPlayer *player = gameLocal.GetLocalPlayer();
+	if ( !player || !player->weapon || !gameLocal.CheatsOk() ) {
+		return;
+	}
+
+	idVec3 origin;
+	idMat3 axis;
+	player->GetViewPos( origin, axis );
+	idMat3 aimed = axis;
+	player->weapon->XenonMuzzleAim( origin, aimed );
+	const float turn = RAD2DEG( idMath::ACos( idMath::ClampFloat( -1.0f, 1.0f, aimed[0] * axis[0] ) ) );
+	gameLocal.Printf( "muzzle aim: target %s, shot turned %.2f degrees\n",
+		player->bestEnemy.GetEntity() ? player->bestEnemy.GetEntity()->GetName() : "none", turn );
+	if ( args.Argc() > 1 && !idStr::Icmp( args.Argv( 1 ), "aim" ) ) {
+		player->SetViewAngles( aimed[0].ToAngles() );
+	}
+}
