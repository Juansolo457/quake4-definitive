+/*
+================
+idPlayer::FindAimAssistTargetInCone
+
+openQ4: the nearest living, hostile, unobstructed actor whose bounds meet the aim frustum,
+for pm_AimAssist 3. halfSize is the frustum's half width at maxDist.
+================
+*/
+idActor *idPlayer::FindAimAssistTargetInCone( const idFrustum &aimArea, float halfSize, float maxDist ) {
+	const idVec3 eye = GetEyePosition();
+	const idMat3 axis = viewAngles.ToMat3();
+	const idVec3 farCenter = eye + axis[0] * maxDist;
+	idBounds bounds( eye );
+	for ( int i = 0; i < 4; i++ ) {
+		bounds.AddPoint( farCenter + axis[1] * ( ( i & 1 ) ? halfSize : -halfSize ) + axis[2] * ( ( i & 2 ) ? halfSize : -halfSize ) );
+	}
+
+	idClipModel *clipModels[ MAX_GENTITIES ];
+	const int count = gameLocal.ClipModelsTouchingBounds( this, bounds, CONTENTS_BODY, clipModels, MAX_GENTITIES );
+	idActor *best = NULL;
+	float bestDist = maxDist;
+	for ( int i = 0; i < count; i++ ) {
+		idEntity *ent = clipModels[ i ]->GetEntity();
+		if ( ent == NULL || ent->IsHidden() || ent->health <= 0 || !ent->IsType( idAI::GetClassType() ) ||
+			static_cast<idAI *>( ent )->team == team ) {
+			continue;
+		}
+		const idBounds &absBounds = ent->GetPhysics()->GetAbsBounds();
+		const float dist = absBounds.ShortestDistance( eye );
+		if ( dist >= bestDist || !aimArea.IntersectsBounds( absBounds ) ) {
+			continue;
+		}
+		trace_t tr;
+		gameLocal.TracePoint( this, tr, eye, absBounds.GetCenter(), MASK_SHOT_BOUNDINGBOX, this );
+		if ( tr.fraction < 1.0f && tr.c.entityNum != ent->entityNumber ) {
+			continue;
+		}
+		bestDist = dist;
+		best = static_cast<idActor *>( ent );
+	}
+	return best;
 }
 
