diff --git a/src/sys/sdl3/sdl3_backend.cpp b/src/sys/sdl3/sdl3_backend.cpp
index 84d6054..b19694b 100644
--- a/src/sys/sdl3/sdl3_backend.cpp
+++ b/src/sys/sdl3/sdl3_backend.cpp
@@ -190,6 +190,8 @@ static idCVar in_gamepadFamily("in_gamepadFamily", "none", CVAR_SYSTEM | CVAR_RO
 	"nintendo, steamdeck or generic");
 int Sys_SDL_GamepadGlyphFamily(int faceLabels[4]);
 static idCVar in_joystickDeadZone("in_joystickDeadZone", "0.18", CVAR_SYSTEM | CVAR_ARCHIVE | CVAR_FLOAT, "joystick axis dead zone", 0.0f, 0.95f);
+static idCVar in_joystickXenon("in_joystickXenon", "0", CVAR_SYSTEM | CVAR_ARCHIVE | CVAR_BOOL, "Xbox 360 Quake 4 controller feel: square stick gate, per-axis XInput dead zones, 360 look curve, "
+	"smoothing and speeds (in_xenon*), 360 trigger threshold; replaces in_joystickDeadZone, curves and look sensitivity");
 static idCVar in_joystickTriggerThreshold("in_joystickTriggerThreshold", "0.35", CVAR_SYSTEM | CVAR_ARCHIVE | CVAR_FLOAT, "trigger button press threshold", 0.0f, 1.0f);
 static idCVar in_joystickLookSensitivity("in_joystickLookSensitivity", "0.75", CVAR_SYSTEM | CVAR_ARCHIVE | CVAR_FLOAT, "controller look sensitivity scale", 0.1f, 4.0f);
 static idCVar in_joystickLookCurve("in_joystickLookCurve", "1.35", CVAR_SYSTEM | CVAR_ARCHIVE | CVAR_FLOAT, "controller look response curve", 1.0f, 3.0f);
@@ -1700,6 +1702,39 @@ static void SDL3_NormalizeStickAxes(Sint16 rawX, Sint16 rawY, float deadZone, fl
 	outY = SDL3_AxisFloatToJoystickValue(y * unitScale);
 }
 
+// in_joystickXenon stick processing, from the Xbox 360 build (default.xex 0x822B6030 and
+// 0x822B5F68).  The stick vector is first stretched from the round gate to a square, so a
+// full diagonal reaches full deflection on both axes; then each axis has its own XInput
+// dead zone with a linear rescale to the +/-127 range.  The 360 truncates to a short
+// between the two steps and to an int at the end.
+static const float SDL3_XENON_LEFT_THUMB_DEADZONE = 7849.0f;	// XINPUT_GAMEPAD_LEFT_THUMB_DEADZONE
+static const float SDL3_XENON_RIGHT_THUMB_DEADZONE = 8689.0f;	// XINPUT_GAMEPAD_RIGHT_THUMB_DEADZONE
+
+static int SDL3_XenonAxisDeadZone(float value, float deadZone) {
+	if (value > deadZone) {
+		return static_cast<int>((value - deadZone) / (32767.0f - deadZone) * 127.0f);
+	}
+	if (value < -deadZone) {
+		return static_cast<int>((value + deadZone) / (32767.0f - deadZone) * 127.0f);
+	}
+	return 0;
+}
+
+static void SDL3_XenonStickAxes(Sint16 rawX, Sint16 rawY, bool rightStick, int &outX, int &outY) {
+	float x = static_cast<float>(rawX);
+	float y = static_cast<float>(rawY);
+	const float major = Max(fabsf(x), fabsf(y));
+	if (major > 0.0f) {
+		const float scale = sqrtf(x * x + y * y) / major;
+		x = SDL3_ClampRange(x * scale, -32767.0f, 32767.0f);
+		y = SDL3_ClampRange(y * scale, -32767.0f, 32767.0f);
+	}
+
+	const float deadZone = rightStick ? SDL3_XENON_RIGHT_THUMB_DEADZONE : SDL3_XENON_LEFT_THUMB_DEADZONE;
+	outX = SDL3_XenonAxisDeadZone(static_cast<float>(static_cast<int>(x)), deadZone);
+	outY = SDL3_XenonAxisDeadZone(static_cast<float>(static_cast<int>(y)), deadZone);
+}
+
 static int SDL3_NormalizeSignedAxis(Sint16 value, float deadZone) {
 	int x = 0;
 	int y = 0;
@@ -1929,8 +1964,13 @@ static bool SDL3_TriggerButtonIsDown(int triggerValue, bool wasDown, int pressTh
 static void SDL3_UpdateTriggerButtons(int leftTrigger, int rightTrigger, int eventTime) {
 	const float threshold = SDL3_ClampUnit(in_joystickTriggerThreshold.GetFloat());
 	const int pressThreshold = static_cast<int>(roundf(threshold * 127.0f));
-	const bool leftDown = SDL3_TriggerButtonIsDown(leftTrigger, s_gamepadLeftTriggerDown, pressThreshold);
-	const bool rightDown = SDL3_TriggerButtonIsDown(rightTrigger, s_gamepadRightTriggerDown, pressThreshold);
+	bool leftDown = SDL3_TriggerButtonIsDown(leftTrigger, s_gamepadLeftTriggerDown, pressThreshold);
+	bool rightDown = SDL3_TriggerButtonIsDown(rightTrigger, s_gamepadRightTriggerDown, pressThreshold);
+	if (in_joystickXenon.GetBool()) {
+		// the 360 build counts a trigger byte above 64 of 255 as pressed, with no release hysteresis
+		leftDown = leftTrigger * 255 > 64 * 127;
+		rightDown = rightTrigger * 255 > 64 * 127;
+	}
 
 	if (leftDown != s_gamepadLeftTriggerDown) {
 		s_gamepadLeftTriggerDown = leftDown;
@@ -1963,22 +2003,28 @@ static void SDL3_UpdateGamepadAxes(int eventTime) {
 	int lookX = 0;
 	int lookY = 0;
 
-	SDL3_NormalizeStickAxes(
-		SDL_GetGamepadAxis(s_sdlGamepad, moveAxisX),
-		SDL_GetGamepadAxis(s_sdlGamepad, moveAxisY),
-		deadZone,
-		in_joystickMoveCurve.GetFloat(),
-		1.0f,
-		moveX,
-		moveY);
-	SDL3_NormalizeStickAxes(
-		rawLookX,
-		rawLookY,
-		deadZone,
-		in_joystickLookCurve.GetFloat(),
-		1.0f,
-		lookX,
-		lookY);
+	if (in_joystickXenon.GetBool()) {
+		// dead zones belong to the physical stick, so southpaw swaps them with the roles
+		SDL3_XenonStickAxes(SDL_GetGamepadAxis(s_sdlGamepad, moveAxisX), SDL_GetGamepadAxis(s_sdlGamepad, moveAxisY), southpaw, moveX, moveY);
+		SDL3_XenonStickAxes(rawLookX, rawLookY, !southpaw, lookX, lookY);
+	} else {
+		SDL3_NormalizeStickAxes(
+			SDL_GetGamepadAxis(s_sdlGamepad, moveAxisX),
+			SDL_GetGamepadAxis(s_sdlGamepad, moveAxisY),
+			deadZone,
+			in_joystickMoveCurve.GetFloat(),
+			1.0f,
+			moveX,
+			moveY);
+		SDL3_NormalizeStickAxes(
+			rawLookX,
+			rawLookY,
+			deadZone,
+			in_joystickLookCurve.GetFloat(),
+			1.0f,
+			lookX,
+			lookY);
+	}
 
 	moveY = -moveY;
 	if (in_joystickInvertLook.GetBool()) {
@@ -5201,7 +5247,7 @@ bool Sys_SDL_PumpEvents(void) {
 		in_touchpadSensitivity.ClearModified();
 		in_touchscreen.ClearModified();
 	}
-	if (in_joystickDeadZone.IsModified() || in_joystickTriggerThreshold.IsModified() ||
+	if (in_joystickDeadZone.IsModified() || in_joystickTriggerThreshold.IsModified() || in_joystickXenon.IsModified() ||
 			in_joystickLookSensitivity.IsModified() || in_joystickLookCurve.IsModified() ||
 			in_joystickMoveCurve.IsModified() || in_joystickInvertLook.IsModified() ||
 			in_joystickSouthpaw.IsModified() || in_joystickUseDedicatedLookAxes.IsModified() ||
@@ -5216,6 +5262,7 @@ bool Sys_SDL_PumpEvents(void) {
 		}
 		in_joystickDeadZone.ClearModified();
 		in_joystickTriggerThreshold.ClearModified();
+		in_joystickXenon.ClearModified();
 		in_joystickLookSensitivity.ClearModified();
 		in_joystickLookCurve.ClearModified();
 		in_joystickMoveCurve.ClearModified();
