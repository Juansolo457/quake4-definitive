@@ -1181,10 +1189,15 @@ void idUsercmdGenLocal::JoystickMove( void ) {
 	}
 
 	if ( hasDedicatedLookAxis || !ButtonState( UB_STRAFE ) ) {
-		// positive axis values mean stick right/down; turning right decreases yaw and
-		// looking down increases pitch, matching the mouse and keyboard handling above
-		viewangles[YAW] -= anglespeed * ( weaponWheel ? 140.0f : in_yawSpeed.GetFloat() ) * joystickLookSensitivity * lookAxisX;
-		viewangles[PITCH] += anglespeed * ( weaponWheel ? 140.0f : in_pitchSpeed.GetFloat() ) * joystickLookSensitivity * lookAxisY;
+		if ( !weaponWheel && cvarSystem->GetCVarBool( "in_joystickXenon" ) ) {
+			XenonJoystickLook( lookAxisX, lookAxisY, usercmdSeconds );
+		} else {
+			// positive axis values mean stick right/down; turning right decreases yaw and
+			// looking down increases pitch, matching the mouse and keyboard handling above
+			viewangles[YAW] -= anglespeed * ( weaponWheel ? 140.0f : in_yawSpeed.GetFloat() ) * joystickLookSensitivity * lookAxisX;
+			viewangles[PITCH] += anglespeed * ( weaponWheel ? 140.0f : in_pitchSpeed.GetFloat() ) * joystickLookSensitivity * lookAxisY;
+			xenonLookFilter[0] = xenonLookFilter[1] = 0.0f;
+		}
 	}
 
 	if ( hasDedicatedLookAxis ) {
@@ -1200,6 +1213,64 @@ void idUsercmdGenLocal::JoystickMove( void ) {
 	cmd.upmove = idMath::ClampChar( cmd.upmove + joystickAxis[AXIS_UP] );
 }
 
+/*
+=================
+Xenon_LookCurve
+
+The Xbox 360 build's look response (default.xex 0x821C9A08): slow for fine aim
+over the first quarter of the stick, then a steep ramp over the last quarter.
+=================
+*/
+static float Xenon_LookCurve( float axis ) {
+	const float magnitude = idMath::Fabs( axis );
+	float curved;
+	if ( magnitude < 0.25f ) {
+		curved = magnitude * 0.3f;
+	} else if ( magnitude < 0.75f ) {
+		curved = 0.075f + ( magnitude - 0.25f ) * 0.6f;
+	} else {
+		curved = 0.375f + ( magnitude - 0.75f ) * 2.5f;
+	}
+	return axis < 0.0f ? -curved : curved;
+}
+
+/*
+=================
+idUsercmdGenLocal::XenonJoystickLook
+
+in_joystickXenon: the Xbox 360 build's controller look (default.xex 0x821C9AA8).
+Each axis goes through the 360 curve and a filter that averages it with the previous
+tic's value (reset when the stick centres), then turns the view by m_yaw / m_pitch
+degrees per stick unit per 60 Hz tic.  The 360 scaled that by its SetSlowJoystick
+percent: pm_zoomedSlow while zoomed, the aim assist friction otherwise.
+=================
+*/
+void idUsercmdGenLocal::XenonJoystickLook( float lookAxisX, float lookAxisY, float usercmdSeconds ) {
+	const float tics = usercmdSeconds * static_cast<float>( USERCMD_HZ );
+	const bool curve = in_xenonLookCurve.GetBool();
+	const float input[2] = {
+		curve ? Xenon_LookCurve( lookAxisX ) : lookAxisX,
+		curve ? Xenon_LookCurve( lookAxisY ) : lookAxisY
+	};
+	const bool centered[2] = { lookAxisX == 0.0f, lookAxisY == 0.0f };
+
+	// the 360 ran filter = ( filter + input ) * 0.5 once per tic; keep that rate when
+	// usercmds cover more or less than one tic
+	const float keep = in_xenonSmoothing.GetBool() ? idMath::Pow( 0.5f, tics ) : 0.0f;
+	for ( int i = 0; i < 2; i++ ) {
+		xenonLookFilter[i] = centered[i] ? 0.0f : xenonLookFilter[i] * keep + input[i] * ( 1.0f - keep );
+	}
+
+	float slow = GetJoystickSlowScale();
+	if ( cvarSystem->GetCVarInteger( "pm_isZoomed" ) > 0 ) {
+		slow = static_cast<float>( idMath::ClampInt( 1, 100, in_xenonZoomedSlow.GetInteger() ) ) * 0.01f;
+	}
+
+	// stick units are the 360's +/-127 axis range
+	viewangles[YAW] -= in_xenonYawScale.GetFloat() * 127.0f * xenonLookFilter[0] * slow * tics;
+	viewangles[PITCH] += in_xenonPitchScale.GetFloat() * 127.0f * xenonLookFilter[1] * slow * tics;
+}
+
 /*
 ==============
 idUsercmdGenLocal::CmdButtons
@@ -1453,6 +1524,7 @@ void idUsercmdGenLocal::Clear( void ) {
 
 	scoreboardStickDirection = 0;
 	scoreboardStickRepeat = 0;
+	xenonLookFilter[0] = xenonLookFilter[1] = 0.0f;
 }
 
