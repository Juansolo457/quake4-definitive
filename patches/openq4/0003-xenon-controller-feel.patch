+static idCVar in_xenonPitchScale( "in_xenonPitchScale", "0.0209", CVAR_SYSTEM | CVAR_ARCHIVE | CVAR_FLOAT, "in_joystickXenon pitch: degrees per stick unit per 60 Hz tic (360 m_pitch; its menu slider ran 0.006-0.06)", 0.001f, 0.2f );
+static idCVar in_xenonZoomedSlow( "in_xenonZoomedSlow", "30", CVAR_SYSTEM | CVAR_ARCHIVE | CVAR_INTEGER, "in_joystickXenon controller turn speed percent while zoomed (360 pm_zoomedSlow)", 1, 100 );
+static idCVar in_xenonLookCurve( "in_xenonLookCurve", "1", CVAR_SYSTEM | CVAR_ARCHIVE | CVAR_BOOL, "in_joystickXenon: 1 applies the 360 three-segment look acceleration curve, 0 is linear" );
