+// Controller focus moved to a row outside the visible part of a settings list
+// (the GUI's scrollIntoView command). Scroll the least that shows the whole row.
+static bool ScrollMainMenuSettingsRowIntoView( idUserInterface *gui, const char *contentName, int rowY, int rowHeight, int viewHeight ) {
+	if ( gui == NULL || contentName == NULL || contentName[ 0 ] == '\0' ) {
+		return false;
+	}
+	const int nameLength = idStr::Length( contentName );
+	for ( int i = 0; i < static_cast<int>( sizeof( MAINMENU_SETTINGS_SCROLL_PAGES ) / sizeof( MAINMENU_SETTINGS_SCROLL_PAGES[ 0 ] ) ); ++i ) {
+		const mainMenuSettingsScrollPage_t &page = MAINMENU_SETTINGS_SCROLL_PAGES[ i ];
+		if ( idStr::Icmpn( page.contentRectState, contentName, nameLength ) != 0 || page.contentRectState[ nameLength ] != ':' ) {
+			continue;
+		}
+		int contentHeight;
+		float stepY;
+		MainMenuSettingsScrollExtent( gui, page, contentHeight, stepY );
+		if ( stepY <= 0.0f ) {
+			return false;
+		}
+		// The content sits at baseY - stepY * scroll inside the view.
+		const int lastShowingTop = idMath::Ftoi( idMath::Floor( static_cast<float>( page.baseY + rowY ) / stepY ) );
+		const int firstShowingBottom = idMath::Ftoi( idMath::Ceil( static_cast<float>( page.baseY + rowY + rowHeight - viewHeight ) / stepY ) );
+		const int current = idMath::ClampInt( page.minValue, page.maxValue, gui->GetStateInt( page.scrollStateName, va( "%d", page.scrollCvar->GetInteger() ) ) );
+		int next = current;
+		if ( current > lastShowingTop ) {
+			next = lastShowingTop;
+		} else if ( current < firstShowingBottom ) {
+			next = firstShowingBottom;
+		}
+		return AdjustMainMenuPageScroll( gui, page, next - current, false, false );
+	}
+	return false;
+}
