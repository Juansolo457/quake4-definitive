+// Settings rows pair a slider with a numeric box showing the same value. On a
+// controller the slider is the control; the box would take every D-pad press.
+static idSliderWindow *SliderForValueEdit( idWindow *window ) {
+	if ( dynamic_cast<idEditWindow *>( window ) == NULL || window->GetParent() == NULL ) {
+		return NULL;
+	}
+	idWindow *row = window->GetParent();
+	for ( int i = 0; i < row->GetChildCount(); ++i ) {
+		idSliderWindow *slider = dynamic_cast<idSliderWindow *>( row->GetChild( i ) );
+		if ( slider != NULL && !slider->IsScrollbar() ) {
+			return slider;
+		}
+	}
+	return NULL;
+}
