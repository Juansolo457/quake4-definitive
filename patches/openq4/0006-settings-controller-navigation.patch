+static void RunControllerHoverScript( idWindow *window, bool enter ) {
+	if ( enter ) {
+		window->MouseEnter();
+	} else {
+		window->MouseExit();
+	}
+	// Pass on what the script asks for (the hover sound), as mouse hover does.
+	if ( window->cmd.Length() && window->GetGui() != NULL ) {
+		window->GetGui()->GetPendingCmd() += window->cmd;
+		window->GetGui()->GetPendingCmd() += " ; ";
+		window->cmd.Clear();
+	}
+}
+
+// Settings rows light up from a separate "<row>_hover" window that only the
+// mouse reaches. Find it so controller focus lights the row too.
+static idWindow *FindRowHoverWindow( idWindow *focus ) {
+	idWindow *desktop = focus->GetGui() != NULL ? focus->GetGui()->GetDesktop() : NULL;
+	if ( desktop == NULL ) {
+		return NULL;
+	}
+	for ( idWindow *row = focus; row != NULL && row != desktop; row = row->GetParent() ) {
+		drawWin_t *hover = desktop->FindChildByName( va( "%s_hover", row->GetName() ) );
+		if ( hover != NULL && hover->win != NULL && hover->win != focus && hover->win->IsVisible() ) {
+			return hover->win;
+		}
+	}
+	return NULL;
+}
+
+static void SetControllerHover( idWindow *focus, bool enter ) {
+	if ( focus == NULL ) {
+		return;
+	}
+	RunControllerHoverScript( focus, enter );
+	idWindow *rowHover = FindRowHoverWindow( focus );
+	if ( rowHover != NULL ) {
+		RunControllerHoverScript( rowHover, enter );
+	}
+}
+
+// A focused row in a scrolled list (a clipping view around a taller content
+// window) can sit outside the view. The menu owns each list's scroll steps, so
+// ask it to bring the row into view.
+static void RequestScrollIntoView( idWindow *focus ) {
+	for ( idWindow *row = focus; row != NULL; row = row->GetParent() ) {
+		idWindow *content = row->GetParent();
+		idWindow *view = content != NULL ? content->GetParent() : NULL;
+		if ( view == NULL ) {
+			return;
+		}
+		const idRectangle &rowRect = row->GetDrawRect();
+		const idRectangle &contentRect = content->GetDrawRect();
+		const idRectangle &viewRect = view->GetDrawRect();
+		if ( ( view->GetFlags() & WIN_NOCLIP ) || contentRect.h <= viewRect.h ) {
+			continue;
+		}
+		const float top = contentRect.y + rowRect.y;
+		if ( rowRect.y >= 0.0f && ( top < 0.0f || top + rowRect.h > viewRect.h ) && focus->GetGui() != NULL ) {
+			focus->GetGui()->GetPendingCmd() += va( "scrollIntoView %s %d %d %d ; ", content->GetName(),
+				idMath::Ftoi( rowRect.y ), idMath::Ftoi( rowRect.h ), idMath::Ftoi( viewRect.h ) );
+		}
+		return;
+	}
+}
