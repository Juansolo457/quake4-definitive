+/*
+================
+idWindow::DrawControllerFocus
+
+openQ4: outlines the desktop's focused control while a controller drives the menu.
+Many controls (key bindings, buttons) only light up under the mouse, so without
+this nothing on screen shows where the D-pad is. Called from the desktop's Redraw
+after its children, whose drawing has just updated their screen positions.
+================
+*/
+void idWindow::DrawControllerFocus() {
+	idWindow *focus = GetFocusedChild();
+	if ( focus == NULL || focus == this ) {
+		return;
+	}
+	idRectangle box( focus->actualX, focus->actualY, focus->drawRect.w, focus->drawRect.h );
+	// Only what is drawn: every ancestor visible, and inside each clipping one (scrolled lists).
+	for ( idWindow *w = focus; w != NULL && w != this; w = w->parent ) {
+		if ( !w->IsVisible() ) {
+			return;
+		}
+		idWindow *clip = w->parent;
+		if ( clip != NULL && clip != this && !( clip->flags & WIN_NOCLIP ) ) {
+			const float x0 = Max( box.x, clip->actualX );
+			const float y0 = Max( box.y, clip->actualY );
+			const float x1 = Min( box.x + box.w, clip->actualX + clip->drawRect.w );
+			const float y1 = Min( box.y + box.h, clip->actualY + clip->drawRect.h );
+			if ( x1 <= x0 || y1 <= y0 ) {
+				return;
+			}
+			box = idRectangle( x0, y0, x1 - x0, y1 - y0 );
+		}
+	}
+	static const idVec4 fill( 1.0f, 0.745f, 0.137f, 0.12f );
+	static const idVec4 edge( 1.0f, 0.745f, 0.137f, 0.9f );
+	dc->SetTransformInfo( vec3_origin, mat3_identity );
+	dc->DrawFilledRect( box.x - 2.0f, box.y - 1.0f, box.w + 4.0f, box.h + 2.0f, fill );
+	dc->DrawRect( box.x - 2.0f, box.y - 1.0f, box.w + 4.0f, box.h + 2.0f, 1.0f, edge );
+}
