 			delta = -MENU_SETTINGS_PAGE_SCROLL_STEP;
 			break;
 		case K_PGDN:
 		case K_KP_PGDN:
-		case K_JOY2:
+		case K_JOY15:	// right trigger
 			delta = MENU_SETTINGS_PAGE_SCROLL_STEP;
 			break;
 		case K_HOME:
@@ -4743,6 +4771,23 @@ void idSessionLocal::MenuEvent( const sysEvent_t *event ) {
 	}
 
 	if ( event->evType == SE_KEY && event->evValue2 == 1 ) {
+		const char *tabCommand = MainMenuSettingsTabCommand( guiActive, event->evValue );
+		if ( tabCommand != NULL ) {
+			if ( tabCommand[ 0 ] ) {
+				DispatchCommand( guiActive, idStr( tabCommand ).c_str() );
+			}
+			// Focus the new page's first control, as a D-pad press would from nothing.
+			sysEvent_t down;
+			memset( &down, 0, sizeof( down ) );
+			down.evType = SE_KEY;
+			down.evValue = K_JOY10;
+			down.evValue2 = 1;
+			if ( guiActive != NULL ) {
+				guiActive->HandleEvent( &down, common->GetPresentationTime() );
+			}
+			SyncMainMenuSettingsScrollPages( guiActive );
+			return;
+		}
 		if ( HandleMainMenuSettingsScrollInput( guiActive, event->evValue ) ) {
 			return;
 		}
