+const char *idUserInterfaceLocal::RunWindowAction( const char *windowName ) {
+	drawWin_t *found = desktop != NULL ? desktop->FindChildByName( windowName ) : NULL;
+	if ( found == NULL || found->win == NULL ) {
+		return NULL;
+	}
+	idWindow *window = found->win;
+	window->cmd.Clear();
+	window->RunScript( idWindow::ON_ACTION );
+	returnCmd = window->cmd;
+	window->cmd.Clear();
+	return returnCmd.c_str();
+}
