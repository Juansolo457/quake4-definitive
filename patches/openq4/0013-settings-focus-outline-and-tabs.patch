 static bool HandleMainMenuSettingsScrollInput( idUserInterface *gui, int key ) {
 	int delta = 0;
 	bool toStart = false;
@@ -4656,12 +4684,12 @@ static bool HandleMainMenuSettingsScrollInput( idUserInterface *gui, int key ) {
 			break;
 		case K_PGUP:
 		case K_KP_PGUP:
-		case K_JOY1:
