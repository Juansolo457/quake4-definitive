+// The Settings tabs in order, by page (desktop::curr) and the button that opens it.
+static const struct mainMenuSettingsTab_t {
+	int page;
+	const char *button;
+} MAINMENU_SETTINGS_TABS[] = {
+	{ 9, "set_b_controls" },
+	{ 21, "set_b_gameoptions" },
+	{ 22, "set_b_system" },
+	{ 36, "set_b_audio" },
+};
+
+// LB/RB on a Settings page press the previous or next tab's button. Returns the
+// command the button produced (possibly ""), or NULL when the key is not a tab switch.
+static const char *MainMenuSettingsTabCommand( idUserInterface *gui, int key ) {
+	if ( gui == NULL || ( key != K_JOY1 && key != K_JOY2 ) || MainMenuSettingsPopupIsVisible( gui ) ) {
+		return NULL;
+	}
+	const int count = static_cast<int>( sizeof( MAINMENU_SETTINGS_TABS ) / sizeof( MAINMENU_SETTINGS_TABS[ 0 ] ) );
+	for ( int i = 0; i < count; ++i ) {
+		if ( MainMenuWindowStateEqualsInt( gui, "desktop::curr", MAINMENU_SETTINGS_TABS[ i ].page ) ) {
+			const int next = ( i + ( key == K_JOY2 ? 1 : count - 1 ) ) % count;
+			return gui->RunWindowAction( MAINMENU_SETTINGS_TABS[ next ].button );
+		}
+	}
+	return NULL;
+}
