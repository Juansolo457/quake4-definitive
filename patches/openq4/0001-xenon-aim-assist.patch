+/*
+================
+Player_SetJoystickSlow
+
+openQ4: PC stand-in for the Xenon usercmdGen->SetSlowJoystick().  The scope slowdown already
+reaches the engine through pm_isZoomed, so while zoomed only that applies; otherwise the
+aim assist friction percent goes out through pm_joystickSlow (0 or 100 means full speed).
+================
+*/
+static void Player_SetJoystickSlow( bool zoomed, int percent ) {
+	cvarSystem->SetCVarInteger( "pm_joystickSlow", ( zoomed || percent >= 100 ) ? 0 : percent );
+}
