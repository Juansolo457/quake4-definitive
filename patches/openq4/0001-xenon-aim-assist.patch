+/*
+=================
+idUsercmdGenLocal::GetJoystickSlowScale
+
+Xenon idUsercmdGen::SetSlowJoystick: the game sets pm_joystickSlow to the aim assist friction
+percent while the crosshair is on an enemy.  Controller look only; the mouse is never slowed.
+=================
+*/
+float idUsercmdGenLocal::GetJoystickSlowScale( void ) const {
+	const int slowPercent = cvarSystem->GetCVarInteger( "pm_joystickSlow" );
+	if ( slowPercent <= 0 || slowPercent >= 100 ) {
+		return 1.0f;
+	}
+
+	return static_cast<float>( slowPercent ) * 0.01f;
+}
